         • img — no rounding, no border; overflow:hidden on frame clips corners
    ───────────────────────────────────────────────────────────────── */
    .tab-graphic .img-frame {
        background-color: #ffffff;
        border-radius: 20px;
        border: 12px solid rgba(0, 0, 0, 0.8);
        box-sizing: border-box;
        overflow: hidden;
        padding: 8px 8px 0;
