/* Step 1: Make both images stack on top of each other */
.link-def,
.link-hov {
  position: absolute;
  top: 0;
  left: 0;
  transition: opacity 0.3s ease-in-out;
}

/* Step 2: Initially show the default image and hide the hover image */
.link-def {
  opacity: 1;
  z-index: 1; /* Default image on top */
}

.link-hov {
  opacity: 0;
  z-index: 0; /* Hover image is initially hidden */
}

/* Step 3: On hover, show the hover image and hide the default image */
.link-def:hover {
  opacity: 0;
}

.link-def:hover ~ .link-hov {
  opacity: 1;
}

