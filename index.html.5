    // Email domain validation
    (function () {
        function initEmailValidation() {
            const form = document.querySelector('form[id^="mktoForm_"]');
            const emailInput = document.getElementById('Email');

            if (!form || !emailInput) return false;

            // Check if already initialized
            if (document.getElementById('blocked-domain-error')) return true;

            // Create error message element
            const errorMsg = document.createElement('div');

            errorMsg.id = 'blocked-domain-error';
            errorMsg.style.cssText = 'display: none;';
            errorMsg.textContent = 'Please use your work email (e.g. you@yourcompany.com).';
            emailInput.parentNode.insertBefore(errorMsg, emailInput.nextSibling);

            function isBlockedDomain(email) {
                const domain = email.split('@')[1];
                if (!domain) return false;
                return blockedEmailDomains.includes(domain.toLowerCase());
            }

            function validateEmail() {
                const email = emailInput.value.trim();
                if (isBlockedDomain(email)) {
                    errorMsg.style.display = 'block';
                    return false;
                } else {
                    errorMsg.style.display = 'none';
                    emailInput.style.borderColor = '';
                    return true;
                }
            }

            // Validate on input change
            emailInput.addEventListener('input', validateEmail);
            emailInput.addEventListener('blur', validateEmail);

            // Prevent form submission if blocked - standard form handler
            form.addEventListener('submit', function (e) {
                if (!validateEmail()) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }
            });

            // Also hook into Marketo's form submission if available
            if (typeof MktoForms2 !== 'undefined' && MktoForms2.whenReady) {
                MktoForms2.whenReady(function (mktoForm) {
                    mktoForm.onValidate(function () {
                        if (!validateEmail()) {
                            mktoForm.submittable(false);
                        } else {
                            mktoForm.submittable(true);
                        }
                    });
                });
            }

            return true;
        }

        function waitForForm() {
            // Try to initialize immediately
