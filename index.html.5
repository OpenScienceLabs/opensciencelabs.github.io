<script>
    document.addEventListener('DOMContentLoaded', function () {
        const hubTabs = document.querySelectorAll('.hub-tab');
        const tabGraphics = document.querySelectorAll('.tab-graphic');
        let currentIndex = 0;

        function switchTab(index) {
            const tabId = hubTabs[index].getAttribute('data-tab');
            hubTabs.forEach(t => t.classList.remove('is-active'));
            hubTabs[index].classList.add('is-active');
            tabGraphics.forEach(g => g.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
        }

        function autoPlayTabs() {
            switchTab(currentIndex);
            currentIndex = (currentIndex + 1) % hubTabs.length;
        }

        setInterval(autoPlayTabs, 3800);

        hubTabs.forEach(function (tab, index) {
            tab.addEventListener('click', function () {
                currentIndex = index;
                switchTab(index);
            });
        });
    });
