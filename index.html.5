/* Global Buttons */
[class*="btn"] a{
    display: inline-flex;
    align-items: center;
    &::after{
        content:'';
        display: inline-block;
        width: 1rem;
        height: 1rem;
        background: currentColor;
        mask-image: url(https://www.anaconda.com/wp-content/uploads/2024/11/arrow-right.svg);
        mask-size: contain;
        mask-repeat: no-repeat;
        margin-left: 0.5ch;
        transition: transform .2s ease-in-out
    }
    &:hover::after,
    &:focus-visible::after,
    &:active::after{
        -webkit-transform: translateX(5px);
        -ms-transform: translateX(5px);
        transform: translateX(5px);
    }
}
.btn--small a{
    font-size: 14px !important;
    padding-block: .5em;
    padding-right: 20px;
}
.btn--icon a{
    border-radius: 50% !important;
    aspect-ratio: 1;
    padding: 1em;
    .btn--small &{
        padding: .75em;
    }
    &::after{
        margin: 0;
        transform: none !important;
    }
    .elementor-button-text{
        border: 0 !important;
    	clip: rect(1px, 1px, 1px, 1px) !important;
    	-webkit-clip-path: inset(50%) !important;
    	clip-path: inset(50%) !important;
    	height: 1px !important;
    	overflow: hidden !important;
    	margin: -1px !important;
    	padding: 0 !important;
    	position: absolute !important;
    	width: 1px !important;
    	white-space: nowrap !important;
    }
}
.elementor-widget-button.btn--link a,
.elementor-widget-button.btn--link a:visited{
    background: none;
    padding-inline: 0;
    color: #6d5bf6 !important;
    text-decoration: none !important;
    
    .btn--link-green &{
        color: #08ca4a !important;
    }
    .btn--link-black &{
        color: #2c2c2c !important;
    }
    
    &:hover, &:focus-visible, &:active{
        text-decoration: underline;
        text-underline-offset: .25em;
        background: none;
        color: #6d5bf6 !important;
        .btn--link-green &{
            color: #08ca4a !important;
        }
        .btn--link-black &{
            color: #2c2c2c !important;
        }
    }
}
.elementor-widget-button.btn--secondary a,
.elementor-widget-button.btn--secondary a:visited{
    color: white !important;
    text-decoration: none !important;
    background: black;
    
    &:hover, &:focus-visible, &:active{
        color: white !important;
        background: #60636a;
    }
    &::after{
        background-color: white;
    }
    
    svg{
        fill: white;
    }
}
.elementor-widget-button.btn--tertiary a,
.elementor-widget-button.btn--tertiary a:visited{
    color: black !important;
    text-decoration: none !important;
    background: white;
    border: 1px solid #c9cdd5;
    
    &:hover, &:focus-visible, &:active{
        color: black !important;
        background: #e1e4e8;
    }
    
    svg{
        fill: black;
    }
}
.btn--download a{
    display: inline-flex;
    align-items: center;
    position: relative;
    padding-right: 15px;
    .elementor-button-content-wrapper{
        gap: 10px;
    }
    &::before{
        content:'';
        height: 100%;
        width: 1px;
        position: absolute;
        background: currentColor;
        right: 45px;
    }
    &::after{
        margin-left: 3ch;
        rotate: 90deg;
        transform: none !important;
    }
    .btn--tertiary &{
        &::before{
            background: #c9cdd5;
        }
    }
}
pre.w-code-block { overflow-x: auto; }
.elementor-widget-text-editor a {
    color: #6d5bf6 !important;
    text-decoration: underline;
    transition: .3s ease;
}/* End custom CSS */
